<div class="col-md-3 mb-3">
    <div class="card custom-card">
        <img src="images/@Book.BookCover" class="card-img-top custom-card-img" alt="@Book.Title" />
        <div class="card-body">
            <h5 class="card-title">@Book.Title</h5>
            <p class="card-text">Author: @Book.Author</p>
            <p class="card-text">Publisher: @Book.Publisher</p>
            <p class="card-text">Category: @Book.Category</p>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <a href="/updatebook/@Book.Id" class="btn btn-primary">Update</a>
                <button @onclick="ConfirmDialog" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

<DeleteDialog 
    @bind-Display="displayDialog"
    OnCancel="HideDeleteDialog"
    OnDelete="DeleteBookAsync">
    <h3 style="color:red;font-weight:bold">Confirm delete: @Book.Title ?</h3>
</DeleteDialog>

@code{
    [Parameter]
    public required Domain.Entities.Books Book { get; set; }

    [Parameter]
    public EventCallback OnBookDeleted { get; set; }

    private bool displayDialog = false;

    private void ConfirmDialog()
    {
        displayDialog = true;
    }
    private void HideDeleteDialog()
    {
        displayDialog = false;
    }
    private async Task DeleteBookAsync()
    {
        await BookRepository.DeleteBookAsync(Book.Id) ;
        displayDialog = false;
        await OnBookDeleted.InvokeAsync();
    }
}