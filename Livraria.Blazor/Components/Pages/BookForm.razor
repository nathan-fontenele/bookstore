<EditForm Model="Book" OnValidSubmit="HandleValidSubmit" FormName="BookForm">
    <h3>@TitlePage</h3>

    @if (IsEdit)
    {
        <input type="hidden" name="Book.Id" value="@Book.Id" />
    }

    <div class="mb-3">
        <label for="Title" class="form-label">Title</label>
        <InputText id="Title" class="form-control" @bind-Value="Book.Title" />
        <ValidationMessage For="() => Book.Title" />
    </div>

    <div class="mb-3">
        <label for="Author" class="form-label">Author</label>
        <InputText id="Author" class="form-control" @bind-Value="Book.Author" />
        <ValidationMessage For="() => Book.Author" />
    </div>

    <div class="mb-3">
        <label for="BookCover" class="form-label">Book Cover</label>
        <InputText id="BookCover" class="form-control" @bind-Value="Book.BookCover" />
        <ValidationMessage For="() => Book.BookCover" />
    </div>

    <div class="mb-3">
        <label for="ReleaseDate" class="form-label">Release Date</label>
        <InputDate id="ReleaseDate" class="form-control" @bind-Value="Book.ReleaseDate" />
    </div>

    <div class="mb-3">
        <label for="Publisher" class="form-label">Publisher</label>
        <InputSelect id="Publisher" class="form-select" @bind-Value="Book.Publisher">
            <option value="">Select a publisher</option>
            @foreach (var publisher in Enum.GetValues<Publisher>())
            {
                <option value="@publisher">@publisher</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label for="Category" class="form-label">Category</label>
        <InputSelect id="Category" class="form-select" @bind-Value="Book.Category">
            <option value="">Select a category</option>
            @foreach (var category in Enum.GetValues<Category>())
            {
                <option value="@category">@category</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/books" class="btn btn-secondary ms-3" data-enhance-nav="false">
            Return to books
        </a>
    </div>
    <DataAnnotationsValidator />
    <ValidationSummary />
</EditForm>

@code {
    [Parameter]
    public bool IsEdit { get; set; } = false;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public EventCallback<Books> OnValidBookSubmit { get; set; }

    public Books? Book { get; set; }
    private string TitlePage => IsEdit ? "Update Book" : "Create Book";

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            Book ??= await BookRepository.GetBookByIdAsync(Id);
        }
        else
        {
            Book = new Books(
                Guid.NewGuid(),
                null,
                null,
                null,
                DateTime.Now,
                Publisher.NA,
                Category.NA);
        }
    }

    private async Task HandleValidSubmit()
    {
        if (OnValidBookSubmit.HasDelegate && Book is not null)
        {
            await OnValidBookSubmit.InvokeAsync(Book);
        }
    }

}
